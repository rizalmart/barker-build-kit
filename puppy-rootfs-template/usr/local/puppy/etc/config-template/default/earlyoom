# Default settings for earlyoom. This file is sourced by /bin/sh from
# /etc/rc.d/rc.earlyoom

# Options to pass to earlyoom
# EARLYOOM_ARGS="-r 3600"

# Examples:

# Print memory report every minute instead of every hour
# EARLYOOM_ARGS="-r 60"

# Available minimum memory 5%
# EARLYOOM_ARGS="-m 5"

# Available minimum memory 15% and free minimum swap 5%
# EARLYOOM_ARGS="-m 15 -s 5"

# Avoid killing processes whose name matches this regexp
# EARLYOOM_ARGS="--avoid '(^|/)(init|X|sshd|firefox)$'"

# See more at `earlyoom -h'

EARLYOOM_ARGS="-r 0 -m 12,10 -s 15,10 --avoid '(^|/)(sysvinit|init|systemd.*|busybox|runit|openrc|wayback|X.*|labwc|Hyprland|river|miriway|sway|wayfire|weston|cage|cosmic-comp|dwl|waybox|swayfx|kwin.*|.*server|systemsettings|baloo_file|mutter|muffin|.*-session|pulseaudio|pipewire.*|wireplumber|gvfs.*|dbus.*|freememapplet.*|mpris.*|.*-daemon|.*dm|wpa_supplicant|.*Manager|sstp-client|charon|openvpn|apache2|postgres|node|hiawatha|sqlservr|ssh-agent|filezilla|vsftp|mksquashfs|gcc|clang|rustc|valac|make|ninja|meson|xfburn|k3b|brasero|dd|cdrecord|wodim|.*isofs|xfwm4|xfdesktop|xfce4-.*|xdg-desktop-.*|.*shell|fusermount.*|swaybg|.*wm|.*panel|.*bar|ffmpeg|snapmergepup.*|apt|dnf|pacman|dpkg|xbps|nm-applet|.*service|daemon|save2flash|wget|curl|axel|polkit-.*|.*-volume-monitor|qemu.*|VirtualBox.*|VBox.*|.*d|wine|mixxx|audacity|kwave|kdenlive|flowblade|openshot|photocraft|filmcraft|wps|soffice.*|calligra.*|DesktopEditors|gedit|kate|geany|.*pad|vlc|.*player|mpv|clapper|haruna|dragon|totem|parole|celluloid|kodi|ffplay)$' --prefer '(^|/)(chrome|chrome-sandbox|chromium|firefox|microsoft-edge|brave|epiphany|gnome-web|falkon|midori|waterfox|QtWebEng.*|konqueror|vivaldi|basilisk|palemoon)$'"

