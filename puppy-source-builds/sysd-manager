#!/usr/bin/bash
set -e

echo "[+] Updating apt repositories and installing build dependencies..."

apt-get install -y \
    git \
    curl \
    build-essential \
    pkg-config \
    libglib2.0-dev \
    libgtk-4-dev \
    libgtksourceview-5-dev \
    libadwaita-1-dev \
    libsystemd-dev

# Ensure Rust/Cargo is available in root environment
if [ -f "$HOME/.cargo/env" ]; then
    source "$HOME/.cargo/env"
elif [ -f "/root/.cargo/env" ]; then
    source "/root/.cargo/env"
fi

if ! command -v cargo &> /dev/null; then
    echo "[+] Rust/Cargo not found. Installing via rustup..."
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
    [ -f "$HOME/.cargo/env" ] && source "$HOME/.cargo/env"
fi

WORK_DIR=$(mktemp -d)
cd "$WORK_DIR"

echo "[+] Cloning plrigaux/sysd-manager repository..."
git clone https://github.com/plrigaux/sysd-manager.git
cd sysd-manager

echo "[+] Building sysd-manager in release mode..."
cargo build --release

echo "[+] Installing files to /usr/local..."
install -Dm755 "target/release/sysd-manager" "/usr/local/bin/sysd-manager"

install -vDm644 "target/loc/io.github.plrigaux.sysd-manager.desktop" -t "/usr/local/share/applications"
install -vDm644 "target/loc/io.github.plrigaux.sysd-manager.metainfo.xml" -t "/usr/local/share/metainfo"
install -vDm644 "data/metainfo/io.github.plrigaux.sysd-manager.releases.xml" -t "/usr/local/share/metainfo/releases"
install -vDm644 "data/icons/hicolor/scalable/apps/io.github.plrigaux.sysd-manager.svg" -t "/usr/local/share/icons/hicolor/scalable/apps/"
install -vDm644 "data/schemas/io.github.plrigaux.sysd-manager.gschema.xml" -t "/usr/local/share/glib-2.0/schemas"   
install -vDm644 "data/applications/org.freedesktop.policykit.sysd-manager.policy" -t "/usr/local/share/polkit-1/actions/"
cp -r -v "target/locale"  "/usr/local/share/" 

cd /
rm -rf "$WORK_DIR"

echo "[SUCCESS] sysd-manager compiled and installed cleanly to /usr/local!"
