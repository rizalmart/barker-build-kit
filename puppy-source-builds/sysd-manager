#!/usr/bin/env bash
set -Eeuo pipefail

# ============================================================
# SysD Manager - Main Branch
# Build from source and install on Debian Sid
# Installation prefix: /usr/local
# ============================================================

REPO="https://github.com/plrigaux/sysd-manager.git"
BRANCH="main"
SOURCE_DIR="${SOURCE_DIR:-$HOME/src/sysd-manager}"

PREFIX="/usr/local"
BINDIR="$PREFIX/bin"
DATADIR="$PREFIX/share"
LIBDIR="$PREFIX/lib"

# System integration directories
# These locations are used by Debian system services.
DBUS_DIR="/usr/local/share/dbus-1/system.d"
POLKIT_ACTION_DIR="/usr/local/share/polkit-1/actions"
POLKIT_RULE_DIR="/usr/local/share/polkit-1/rules.d"

APP_ID="io.github.plrigaux.sysd-manager"
BUS_ID="io.github.plrigaux.SysDManager"
PROXY_ID="sysd-manager-proxy"

# ------------------------------------------------------------
# Helpers
# ------------------------------------------------------------

info() {
    printf '\033[1;32m[INFO]\033[0m %s\n' "$*"
}

error() {
    printf '\033[1;31m[ERROR]\033[0m %s\n' "$*" >&2
    exit 1
}

run_root() {
    if [ "$(id -u)" -eq 0 ]; then
        "$@"
    else
        sudo "$@"
    fi
}

install_file() {
    local mode="$1"
    local source="$2"
    local destination="$3"

    [ -f "$source" ] || error "Missing source file: $source"

    run_root install -Dm"$mode" "$source" "$destination"
}

# ------------------------------------------------------------
# Dependencies
# ------------------------------------------------------------

info "Installing build dependencies..."

run_root apt-get update

run_root env DEBIAN_FRONTEND=noninteractive \
    apt-get install -y --no-install-recommends \
    build-essential \
    git \
    ca-certificates \
    pkg-config \
    cargo \
    rustc \
    gettext \
    libgtk-4-dev \
    libadwaita-1-dev \
    libsystemd-dev \
    libgtksourceview-5-dev \
    libglib2.0-bin \
    desktop-file-utils \
    dbus \
    polkitd \
    systemd

# ------------------------------------------------------------
# Clone or update main branch
# ------------------------------------------------------------

mkdir -p "$(dirname "$SOURCE_DIR")"

if [ -d "$SOURCE_DIR/.git" ]; then
    info "Updating repository from $BRANCH..."

    git -C "$SOURCE_DIR" fetch origin "$BRANCH"

    if git -C "$SOURCE_DIR" show-ref \
        --verify --quiet refs/heads/"$BRANCH"; then
        git -C "$SOURCE_DIR" switch "$BRANCH"
    else
        git -C "$SOURCE_DIR" switch \
            -c "$BRANCH" --track "origin/$BRANCH"
    fi

    git -C "$SOURCE_DIR" pull --ff-only origin "$BRANCH"

else
    info "Cloning upstream $BRANCH branch..."

    git clone \
        --depth 1 \
        --single-branch \
        --branch "$BRANCH" \
        "$REPO" \
        "$SOURCE_DIR"
fi

cd "$SOURCE_DIR"

# ------------------------------------------------------------
# Detect version and minimum Rust version
# ------------------------------------------------------------

VERSION="$(
    awk '
        /^\[package\]/ { package=1; next }
        /^\[/ { if (package) exit }
        package && /^version[[:space:]]*=/ {
            gsub(/"/, "", $3)
            print $3
            exit
        }
    ' Cargo.toml
)"

RUST_REQUIRED="$(
    awk '
        /^\[workspace.package\]/ { section=1; next }
        /^\[/ { if (section) exit }
        section && /^rust-version[[:space:]]*=/ {
            gsub(/"/, "", $3)
            print $3
            exit
        }
    ' Cargo.toml
)"

[ -n "$VERSION" ] ||
    error "Unable to detect project version."

[ -n "$RUST_REQUIRED" ] ||
    error "Unable to detect minimum Rust version."

RUST_VERSION="$(rustc --version | awk '{print $2}')"

info "SysD Manager version: $VERSION"
info "Required Rust: $RUST_REQUIRED"
info "Installed Rust: $RUST_VERSION"

if ! dpkg --compare-versions "$RUST_VERSION" ge "$RUST_REQUIRED"; then
    error "Rust $RUST_REQUIRED or newer is required."
fi

# ------------------------------------------------------------
# Compile application and proxy
# ------------------------------------------------------------

info "Compiling SysD Manager and workspace..."

cargo build \
    --workspace \
    --release \
    --locked

BUILD_DIR="target/release"

[ -x "$BUILD_DIR/sysd-manager" ] ||
    error "Main executable missing."

[ -x "$BUILD_DIR/sysd-manager-proxy" ] ||
    error "Proxy executable missing."

# ------------------------------------------------------------
# Generate desktop integration and translations
# ------------------------------------------------------------

info "Generating application integration files..."

cargo run \
    --locked \
    -p transtools \
    -- packfiles

[ -d target/locale ] ||
    error "Generated locale directory missing."

[ -f "target/loc/$APP_ID.desktop" ] ||
    error "Generated desktop entry missing."

[ -f "target/loc/$APP_ID.metainfo.xml" ] ||
    error "Generated AppStream metadata missing."

[ -f "target/loc/$BUS_ID.policy" ] ||
    error "Generated Polkit policy missing."

# ------------------------------------------------------------
# Create temporary directory
# ------------------------------------------------------------

TMP_DIR="$(mktemp -d)"

trap 'rm -rf "$TMP_DIR"' EXIT

# ------------------------------------------------------------
# Install executables
# ------------------------------------------------------------

info "Installing executables..."

install_file 0755 \
    "$BUILD_DIR/sysd-manager" \
    "$BINDIR/sysd-manager"

install_file 0755 \
    "$BUILD_DIR/$PROXY_ID" \
    "$BINDIR/$PROXY_ID"

# ------------------------------------------------------------
# Desktop entry
# ------------------------------------------------------------

info "Installing desktop entry..."

install_file 0644 \
    "target/loc/$APP_ID.desktop" \
    "$DATADIR/applications/$APP_ID.desktop"

# ------------------------------------------------------------
# D-Bus configuration
# ------------------------------------------------------------

info "Installing D-Bus configuration..."

DBUS_TEMPLATE="sysd-manager-proxy/data/$BUS_ID.conf"

sed \
    -e "s|{BUS_NAME}|$BUS_ID|g" \
    -e "s|{DESTINATION}|$BUS_ID|g" \
    -e "s|{INTERFACE}|$BUS_ID|g" \
    "$DBUS_TEMPLATE" \
    > "$TMP_DIR/$BUS_ID.conf"

install_file 0644 \
    "$TMP_DIR/$BUS_ID.conf" \
    "$DBUS_DIR/$BUS_ID.conf"

# ------------------------------------------------------------
# Systemd service
# ------------------------------------------------------------

info "Installing systemd proxy service..."

SERVICE_TEMPLATE="sysd-manager-proxy/data/$PROXY_ID.service"

sed \
    -e "s|{SERVICE_ID}|$PROXY_ID|g" \
    -e "s|{DESTINATION}|$BUS_ID|g" \
    -e "s|{EXECUTABLE}|$BINDIR/$PROXY_ID|g" \
    -e "s|{INTERFACE}|$BUS_ID|g" \
    -e "s|{ENVIRONMENT}||g" \
    "$SERVICE_TEMPLATE" \
    > "$TMP_DIR/$PROXY_ID.service"

install_file 0644 \
    "$TMP_DIR/$PROXY_ID.service" \
    "$LIBDIR/systemd/system/$PROXY_ID.service"

# ------------------------------------------------------------
# GSettings schema
# ------------------------------------------------------------

info "Installing GSettings schema..."

install_file 0644 \
    "data/schemas/$APP_ID.gschema.xml" \
    "$DATADIR/glib-2.0/schemas/$APP_ID.gschema.xml"

# ------------------------------------------------------------
# Application icon
# ------------------------------------------------------------

info "Installing application icon..."

install_file 0644 \
    "data/icons/hicolor/scalable/apps/$APP_ID.svg" \
    "$DATADIR/icons/hicolor/scalable/apps/$APP_ID.svg"

# ------------------------------------------------------------
# AppStream metadata
# ------------------------------------------------------------

info "Installing AppStream metadata..."

install_file 0644 \
    "target/loc/$APP_ID.metainfo.xml" \
    "$DATADIR/metainfo/$APP_ID.metainfo.xml"

install_file 0644 \
    "data/metainfo/$APP_ID.releases.xml" \
    "$DATADIR/metainfo/releases/$APP_ID.releases.xml"

# ------------------------------------------------------------
# Polkit policy
# ------------------------------------------------------------

info "Installing Polkit policy..."

install_file 0644 \
    "target/loc/$BUS_ID.policy" \
    "$POLKIT_ACTION_DIR/$BUS_ID.policy"

# ------------------------------------------------------------
# Polkit rules
# ------------------------------------------------------------

info "Installing Polkit rules..."

POLKIT_RULE="sysd-manager-proxy/data/50-$BUS_ID.rules"

install_file 0644 \
    "$POLKIT_RULE" \
    "$POLKIT_RULE_DIR/50-$BUS_ID.rules"

# ------------------------------------------------------------
# Translations
# ------------------------------------------------------------

info "Installing translations..."

while IFS= read -r -d '' MO_FILE; do

    RELATIVE_PATH="${MO_FILE#target/locale/}"

    install_file 0644 \
        "$MO_FILE" \
        "$DATADIR/locale/$RELATIVE_PATH"

done < <(find target/locale -type f -name '*.mo' -print0)

# ------------------------------------------------------------
# Documentation
# ------------------------------------------------------------

info "Installing documentation..."

DOC_DIR="$DATADIR/doc/sysd-manager-$VERSION"

install_file 0644 \
    README.md \
    "$DOC_DIR/README.md"

install_file 0644 \
    CHANGELOG.md \
    "$DOC_DIR/CHANGELOG.md"

# ------------------------------------------------------------
# Refresh system integration
# ------------------------------------------------------------

info "Compiling GSettings schemas..."

run_root glib-compile-schemas \
    "$DATADIR/glib-2.0/schemas"

info "Updating desktop database..."

if command -v update-desktop-database >/dev/null 2>&1; then
    run_root update-desktop-database \
        "$DATADIR/applications"
fi

info "Updating icon cache..."

if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    run_root gtk-update-icon-cache -f \
        "$DATADIR/icons/hicolor" || true
fi

info "Reloading systemd..."

run_root systemctl daemon-reload

# ------------------------------------------------------------
# Installation verification
# ------------------------------------------------------------

info "Verifying installation..."

EXPECTED_FILES=(
    "$BINDIR/sysd-manager"
    "$BINDIR/$PROXY_ID"
    "$LIBDIR/systemd/system/$PROXY_ID.service"
    "$DATADIR/applications/$APP_ID.desktop"
    "$DBUS_DIR/$BUS_ID.conf"
    "$DOC_DIR/README.md"
    "$DOC_DIR/CHANGELOG.md"
    "$DATADIR/glib-2.0/schemas/$APP_ID.gschema.xml"
    "$DATADIR/icons/hicolor/scalable/apps/$APP_ID.svg"
    "$DATADIR/metainfo/$APP_ID.metainfo.xml"
    "$DATADIR/metainfo/releases/$APP_ID.releases.xml"
    "$POLKIT_ACTION_DIR/$BUS_ID.policy"
    "$POLKIT_RULE_DIR/50-$BUS_ID.rules"
)

FAILED=0

for FILE in "${EXPECTED_FILES[@]}"; do
    if [ -f "$FILE" ]; then
        info "OK: $FILE"
    else
        printf '\033[1;31m[MISSING]\033[0m %s\n' "$FILE"
        FAILED=1
    fi
done

[ "$FAILED" -eq 0 ] ||
    error "Installation verification failed."

echo
info "============================================"
info " SysD Manager $VERSION installed successfully"
info "============================================"
info "Branch:     $BRANCH"
info "Executable: $BINDIR/sysd-manager"
info "Proxy:      $BINDIR/$PROXY_ID"
info "Prefix:     $PREFIX"
echo
info "Launch using: sysd-manager"
